# Carsales — environment variables
#
# Copy to `.env.local` and fill in real values.
# Schema: src/lib/env.ts validates these at boot.
#
# Lines starting with `#` are comments.

# ── Database ───────────────────────────────────────────────────
# MongoDB connection string. Must include the `MMC` database in the path
# so the migration script and the app agree on the same database.
MONGODB_URI=mongodb://localhost:27017/MMC

# ── Session ────────────────────────────────────────────────────
# iron-session signing secret. Min 32 characters. Required in production.
# Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-32-or-more-character-random-string

# ── Customer auth (Auth.js / NextAuth v5) ──────────────────────
# Signs customer session JWTs. Required in production. Generate one
# with `npx auth secret` (or the node one-liner above).
AUTH_SECRET=replace-with-random-string
# Canonical site origin for Auth.js. Optional (trustHost derives it from the
# request), but set it in production to your exact public origin — e.g.
# https://www.mmcleeds.co.uk — so the client session fetch is always
# same-origin and never throws ClientFetchError on apex/www/preview aliases.
AUTH_URL=
# Google OAuth client (Web application). Create at
# https://console.cloud.google.com/apis/credentials and register, exactly:
#   Authorised redirect URIs:       http://localhost:3000/api/auth/callback/google
#                                    https://<prod-domain>/api/auth/callback/google
#   Authorised JavaScript origins:  http://localhost:3000  and  https://<prod-domain>
# The OAuth consent screen must be published ("In production", not "Testing")
# before customers other than listed test users can sign in.
# NOTE: leaving these blank does NOT hide the "Continue with Google" button —
# the provider is registered unconditionally (src/auth.ts) and the button still
# renders, so Google sign-in fails until real values are set. Restart the dev
# server after filling them in (env is read at boot). In prod, set both in Vercel.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link sign-in reuses the SMTP_* vars below.

# ── Admin bootstrap ────────────────────────────────────────────
# Used by `npm run setup-admin` to seed the first admin user. Drop the
# password after running the script — login will work from then on.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-then-rotate

# ── Email / SMTP ───────────────────────────────────────────────
# Production must set EMAIL_FROM to a real address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=MMC Leeds

# ── AWS / S3 (image uploads) ───────────────────────────────────
# Read by src/lib/utils/s3.ts. Without these, the upload route will fail.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: serve uploaded images via CloudFront instead of raw S3 URLs.
CLOUDFRONT_DOMAIN=

# ── Cron ───────────────────────────────────────────────────────
# Bearer token Vercel sends in the `Authorization` header for cron
# invocations. Required to reach /api/cron/review-invites.
# REQUIRED IN PRODUCTION — server boot in NODE_ENV=production refuses
# to start without it (see src/lib/env.ts). Without it, every Vercel
# cron call would 500 and review-invite emails would silently stop.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-random-string

# ── Observability ──────────────────────────────────────────────
# Sentry is wired in via @sentry/nextjs. The SDK is gated entirely on
# whether a DSN is present: with no DSN set, Sentry.init never runs,
# captureException becomes a no-op, and src/lib/utils/observability.ts
# falls back to console logging only. So it's safe to deploy without
# these set — leave them empty until the Sentry project is provisioned.
#
# Server-side DSN. Used by sentry.server.config.ts and the gating
# check in src/lib/utils/observability.ts.
SENTRY_DSN=
# Client-side DSN. Inlined into the browser bundle at build time. Set
# this to the same value as SENTRY_DSN — Sentry treats DSNs as public.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload auth token. Without it, `next build` succeeds but
# Sentry won't get readable stack traces. Generate at
# https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
SENTRY_AUTH_TOKEN=
# Optional — Sentry org/project slugs. Required for source-map uploads
# but can be omitted on first-deploy while the project is being set up.
SENTRY_ORG=
SENTRY_PROJECT=

# ── Rate limit (Day 2 Fix 2.4) ─────────────────────────────────
# Vercel KV / Upstash Redis credentials. When unset, createRateLimiter
# falls back to its in-memory implementation (fine for single-instance
# dev). Production deploys should set both for distributed enforcement.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Turnstile (Day 2 Fix 2.5) ──────────────────────────────────
# Cloudflare Turnstile keys. When unset, server-side verification is
# a no-op in dev and a hard 400 in production. The widget hides
# itself when NEXT_PUBLIC_TURNSTILE_SITE_KEY is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Public (NEXT_PUBLIC_*) ─────────────────────────────────────
# These ship to the browser. Don't put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=MMC Leeds
