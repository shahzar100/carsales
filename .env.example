# Carsales — environment variables
#
# Copy to `.env.local` and fill in real values.
# Schema: src/lib/env.ts validates these at boot.
#
# Lines starting with `#` are comments.

# ── Database ───────────────────────────────────────────────────
# MongoDB connection string. Must include the `MMC` database in the path
# so the migration script and the app agree (see CODEBASE_ISSUES C2).
MONGODB_URI=mongodb://localhost:27017/MMC

# ── Session ────────────────────────────────────────────────────
# iron-session signing secret. Min 32 characters. Required in production.
# Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-32-or-more-character-random-string

# ── Customer auth (Auth.js / NextAuth v5) ──────────────────────
# Signs customer session JWTs. Required in production. Generate one
# with `npx auth secret` (or the node one-liner above).
AUTH_SECRET=replace-with-random-string
# Google OAuth client. Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <site-url>/api/auth/callback/google
# Optional — leave blank to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link sign-in reuses the SMTP_* vars below.

# ── Admin bootstrap ────────────────────────────────────────────
# Used by `npm run setup-admin` to seed the first admin user. Drop the
# password after running the script — login will work from then on.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-then-rotate

# ── Email / SMTP ───────────────────────────────────────────────
# Production must set EMAIL_FROM to a real address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=MMC Leeds

# ── AWS / S3 (image uploads) ───────────────────────────────────
# Read by src/lib/utils/s3.ts. Without these, the upload route will fail.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: serve uploaded images via CloudFront instead of raw S3 URLs.
CLOUDFRONT_DOMAIN=

# ── Cron ───────────────────────────────────────────────────────
# Bearer token Vercel sends in the `Authorization` header for cron
# invocations. Required to reach /api/cron/review-invites.
CRON_SECRET=replace-with-random-string

# ── Observability ──────────────────────────────────────────────
# Sentry DSN. When unset, src/lib/utils/observability.ts logs to
# console only (matches current dev behaviour). In production, leave
# this empty until the @sentry/nextjs SDK is installed and wired —
# see SETUP.md "Sentry" section for the full setup steps.
SENTRY_DSN=

# ── Rate limit (Day 2 Fix 2.4) ─────────────────────────────────
# Vercel KV / Upstash Redis credentials. When unset, createRateLimiter
# falls back to its in-memory implementation (fine for single-instance
# dev). Production deploys should set both for distributed enforcement.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Turnstile (Day 2 Fix 2.5) ──────────────────────────────────
# Cloudflare Turnstile keys. When unset, server-side verification is
# a no-op in dev and a hard 400 in production. The widget hides
# itself when NEXT_PUBLIC_TURNSTILE_SITE_KEY is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Public (NEXT_PUBLIC_*) ─────────────────────────────────────
# These ship to the browser. Don't put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=MMC Leeds
