# Carsales — environment variables
#
# Copy to `.env.local` and fill in real values.
# Schema: src/lib/env.ts validates these at boot.
#
# Lines starting with `#` are comments.

# ── Database ───────────────────────────────────────────────────
# MongoDB connection string. Must include the `MMC` database in the path
# so the migration script and the app agree (see CODEBASE_ISSUES C2).
MONGODB_URI=mongodb://localhost:27017/MMC

# ── Session ────────────────────────────────────────────────────
# iron-session signing secret. Min 32 characters. Required in production.
# Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-32-or-more-character-random-string

# ── Admin bootstrap ────────────────────────────────────────────
# Used by `npm run setup-admin` to seed the first admin user. Drop the
# password after running the script — login will work from then on.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-then-rotate

# ── Email / SMTP ───────────────────────────────────────────────
# Production must set EMAIL_FROM to a real address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=MMC Leeds

# ── AWS / S3 (image uploads) ───────────────────────────────────
# Read by src/lib/utils/s3.ts. Without these, the upload route will fail.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: serve uploaded images via CloudFront instead of raw S3 URLs.
CLOUDFRONT_DOMAIN=

# ── Cron ───────────────────────────────────────────────────────
# Bearer token Vercel sends in the `Authorization` header for cron
# invocations. Required to reach /api/cron/review-invites.
CRON_SECRET=replace-with-random-string

# ── Public (NEXT_PUBLIC_*) ─────────────────────────────────────
# These ship to the browser. Don't put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=MMC Leeds
