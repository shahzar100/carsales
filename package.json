{
  "name": "carsales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{tsx,jsx,ts,js}\" --config .prettierrc",
    "format:check": "prettier --check \"src/**/*.{tsx,jsx,ts,js}\" --config .prettierrc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:operational": "node e2e/operational/run.mjs",
    "test:smoke": "playwright test --config e2e/smoke/playwright.smoke.config.ts",
    "setup-admin": "node scripts/setup-admin.mjs",
    "migrate:business-info": "tsx scripts/migrate-business-info.ts",
    "email": "email dev --dir src/emails",
    "size": "size-limit",
    "prepare": "husky"
  },
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "*.{js,jsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.2",
