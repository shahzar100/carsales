    "@types/qrcode": "^1.5.6",
    "@vercel/functions": "^3.4.3",
    "bcryptjs": "^3.0.3",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.542.0",
    "mongodb": "^6.19.0",
    "motion": "^12.23.12",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "otpauth": "^9.5.1",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^5.2.9",
    "recharts": "^3.7.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.17",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
